[Unit]
Description=SFROST signed-cookie authentication gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sfrost_blog
Group=sfrost_blog
WorkingDirectory=/opt/sfrost-auth-gateway
EnvironmentFile=/etc/sfrost-auth-gateway.env
Environment=PORT=3081
Environment=SFROST_AUTH_CREDENTIALS_FILE=/var/lib/sfrost-auth-gateway/credentials.json
Environment=SFROST_BLOG_DB_HOST=/var/run/postgresql
Environment=SFROST_BLOG_DB_NAME=sfrost_blog
Environment=SFROST_BLOG_DB_USER=sfrost_blog
Environment=PATH=/opt/node-v22.19.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/node-v22.19.0/bin/node /opt/sfrost-auth-gateway/server.mjs
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
StateDirectory=sfrost-auth-gateway
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
