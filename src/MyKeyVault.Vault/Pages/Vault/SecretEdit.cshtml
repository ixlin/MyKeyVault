@page "{id:guid}/{secretId:guid?}"
@model MyKeyVault.Vault.Pages.Vault.SecretEditModel
@{ ViewData["Title"] = Model.SecretId is null ? "新增加密字段" : "更新加密字段"; }
<section class="form-heading"><p class="eyebrow">@((Model.SecretId is null) ? "NEW ENCRYPTED FIELD" : "REPLACE ENCRYPTED FIELD")</p><h1>@ViewData["Title"]</h1><p>旧明文不会显示。保存新值后，旧密文会被安全替换。</p></section>
<form method="post" class="vault-form"><div asp-validation-summary="ModelOnly" class="validation"></div><input type="hidden" asp-for="ItemId" /><input type="hidden" asp-for="SecretId" />
<label>字段名称<input asp-for="Input.FieldName" autocomplete="off" placeholder="例如：密码、API Key" /></label><label>新的私密内容<textarea asp-for="Input.SecretValue" autocomplete="off" spellcheck="false"></textarea></label><div class="form-actions"><a asp-page="Details" asp-route-id="@Model.ItemId">取消</a><button class="button" type="submit">加密保存</button></div></form>
