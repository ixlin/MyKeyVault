@page "{id:guid}/{secretId:guid?}"
@model MyKeyVault.Vault.Pages.Vault.SecretEditModel
@{
    ViewData["Title"] = Model.SecretId is null ? "新增加密字段" : "更新加密字段";
}
<a class="ui-breadcrumb" asp-page="Details" asp-route-id="@Model.ItemId">← 返回条目</a>
<header class="ui-page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>旧明文不会显示。保存新值后，旧密文会被安全替换。</p>
    </div>
</header>
<form method="post" class="ui-form ui-card ui-form-card ui-form-wide">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="validation ui-notice ui-notice-danger" role="alert"></div>
    }
    <input type="hidden" asp-for="ItemId" />
    <input type="hidden" asp-for="SecretId" />
    <div class="ui-form-grid">
        <label class="ui-field"><span class="ui-label">字段名称</span><input asp-for="Input.FieldName" autocomplete="off" placeholder="例如：密码、API Key" /><span asp-validation-for="Input.FieldName" class="validation"></span></label>
        <label class="ui-field ui-span-2"><span class="ui-label">新的私密内容</span><textarea asp-for="Input.SecretValue" autocomplete="off" spellcheck="false"></textarea><span asp-validation-for="Input.SecretValue" class="validation"></span></label>
        <p class="ui-note ui-span-2">保存后会使用新的随机数据密钥重新加密，旧密文不会保留。</p>
    </div>
    <div class="ui-form-actions">
        <a class="ui-cancel" asp-page="Details" asp-route-id="@Model.ItemId">取消</a>
        <button class="ui-btn ui-btn-primary" type="submit">加密保存</button>
    </div>
</form>
