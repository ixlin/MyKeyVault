@page
@model MyKeyVault.Vault.Pages.Vault.IndexModel
@{
    ViewData["Title"] = Model.Archived ? "已归档条目" : "密码本";
}
<header class="ui-page-head">
    <div>
        <h1>@(Model.Archived ? "已归档条目" : "密码本")</h1>
        <p>@Model.Items.Count 个条目 · 敏感内容默认遮蔽，显示和复制会写入安全审计。</p>
    </div>
    <div class="ui-page-actions">
        @if (Model.Archived)
        {
            <a class="ui-btn ui-btn-ghost" asp-page="Index">返回密码本</a>
        }
        else
        {
            <a class="ui-btn ui-btn-primary" asp-page="Create">＋ 新增条目</a>
        }
    </div>
</header>

<div class="ui-toolbar" aria-label="筛选和搜索">
    <nav class="ui-tabs" aria-label="条目类型">
        <a class="ui-tab @(string.IsNullOrEmpty(Model.Group) && !Model.Archived ? "is-active" : null)" asp-page="Index" asp-route-query="@Model.Query">全部</a>
        <a class="ui-tab @(Model.Group == "login" && !Model.Archived ? "is-active" : null)" asp-page="Index" asp-route-group="login" asp-route-query="@Model.Query">账号</a>
        <a class="ui-tab @(Model.Group == "card" && !Model.Archived ? "is-active" : null)" asp-page="Index" asp-route-group="card" asp-route-query="@Model.Query">银行卡</a>
        <a class="ui-tab @(Model.Group == "note" && !Model.Archived ? "is-active" : null)" asp-page="Index" asp-route-group="note" asp-route-query="@Model.Query">笔记</a>
        <a class="ui-tab @(Model.Archived ? "is-active" : null)" asp-page="Index" asp-route-archived="true">已归档 @(Model.ArchivedCount > 0 ? $"({Model.ArchivedCount})" : null)</a>
    </nav>
    <form method="get" class="ui-search" role="search">
        <input type="hidden" name="Group" value="@Model.Group" />
        @if (Model.Archived) { <input type="hidden" name="Archived" value="true" /> }
        <label class="visually-hidden" for="query">搜索条目</label>
        <input id="query" name="Query" value="@Model.Query" placeholder="搜索名称、网址或标签" autocomplete="off" />
        <button type="submit">搜索</button>
    </form>
</div>

@if (!Model.Items.Any())
{
    <section class="ui-empty">
        <span class="ui-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="M10.8 12.2 19 4m-3 0h3v3"/></svg></span>
        <h2>@(Model.Archived ? "还没有归档的条目" : string.IsNullOrWhiteSpace(Model.Query) ? "密码本还是空的" : "没有找到匹配的条目")</h2>
        <p>@(Model.Archived ? "在条目详情里选择“归档”后，会出现在这里，也可以随时恢复。" : string.IsNullOrWhiteSpace(Model.Query) ? "添加登录账号、银行卡、信用卡或私密笔记，敏感字段会分别加密。" : "换个关键词，或者清空搜索条件再试一次。")</p>
        @if (Model.Archived)
        {
            <a class="ui-btn ui-btn-ghost" asp-page="Index">返回密码本</a>
        }
        else if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <a class="ui-btn ui-btn-ghost" asp-page="Index">清空搜索</a>
        }
        else
        {
            <a class="ui-btn ui-btn-primary" asp-page="Create">新增第一条</a>
        }
    </section>
}
else
{
    <form method="post" aria-hidden="true" class="antiforgery-holder"></form>
    <div class="ui-table-wrap">
        <table class="ui-table">
            <thead>
                <tr>
                    <th>名称 / 网址</th>
                    <th class="ui-col-type">类型</th>
                    <th>账号</th>
                    <th>密码</th>
                    <th class="ui-col-narrow">更新时间</th>
                    <th class="ui-col-actions">操作</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                var isRevealed = Model.RevealedItemId == item.Id;
                <tr class="@(isRevealed ? "is-revealed" : null)">
                    <td data-label="名称">
                        <div class="vault-name">
                            <span class="vault-kind kind-@item.KindCss" aria-hidden="true">@item.KindMark</span>
                            <div>
                                @if (Model.Archived)
                                {
                                    <span class="vault-title">@item.Title @if (item.IsFavorite) { <span title="优先显示">★</span> }</span>
                                }
                                else
                                {
                                    <a class="vault-title" asp-page="Details" asp-route-id="@item.Id">@item.Title @if (item.IsFavorite) { <span title="优先显示">★</span> }</a>
                                }
                                @if (item.SafeExternalUrl is not null)
                                {
                                    <a class="vault-url" href="@item.SafeExternalUrl" target="_blank" rel="noopener noreferrer">@item.UrlOrHost</a>
                                }
                                else
                                {
                                    <span class="vault-url">@(item.UrlOrHost ?? "未设置网址")</span>
                                }
                                @if (item.Tags.Any())
                                {
                                    <div class="vault-tags">@foreach (var tag in item.Tags) { <span class="vault-tag">@tag</span> }</div>
                                }
                            </div>
                        </div>
                    </td>
                    <td data-label="类型">@item.KindLabel</td>
                    <td data-label="账号">
                        @if (!item.AccountFields.Any()) { <span class="ui-muted">—</span> }
                        @foreach (var field in item.AccountFields)
                        {
                            <div>
                                @if (item.AccountFields.Count > 1) { <span class="ui-help">@field.FieldName</span> }
                                @if (isRevealed && Model.RevealedValues.TryGetValue(field.Id, out var accountValue))
                                {
                                    <span class="vault-actions vault-inline-copy">
                                        <code id="secret-@field.Id">@accountValue</code>
                                        <button type="button" class="copy-icon" data-copy-target="secret-@field.Id" data-copy-url="@Url.Page("Index", "Copy", new { id = item.Id, secretId = field.Id })" aria-label="复制账号" title="复制账号"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg></button>
                                    </span>
                                }
                                else
                                {
                                    <span class="vault-mask" aria-label="已加密">••••••••</span>
                                }
                            </div>
                        }
                    </td>
                    <td data-label="密码">
                        @if (!item.PasswordFields.Any()) { <span class="ui-muted">—</span> }
                        @foreach (var field in item.PasswordFields)
                        {
                            <div>
                                @if (item.PasswordFields.Count > 1) { <span class="ui-help">@field.FieldName</span> }
                                @if (isRevealed && Model.RevealedValues.TryGetValue(field.Id, out var passwordValue))
                                {
                                    <span class="vault-actions vault-inline-copy">
                                        <code id="secret-@field.Id">@passwordValue</code>
                                        <button type="button" class="copy-icon" data-copy-target="secret-@field.Id" data-copy-url="@Url.Page("Index", "Copy", new { id = item.Id, secretId = field.Id })" aria-label="复制密码" title="复制密码"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg></button>
                                    </span>
                                }
                                else
                                {
                                    <span class="vault-mask" aria-label="已加密">••••••••</span>
                                }
                            </div>
                        }
                    </td>
                    <td class="ui-col-narrow" data-label="更新时间">@item.UpdatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td class="ui-col-actions" data-label="">
                        <div class="vault-actions">
                            @if (Model.Archived)
                            {
                                <form method="post" asp-page-handler="Restore"><input type="hidden" name="id" value="@item.Id" /><button type="submit">恢复</button></form>
                                <a class="is-danger" asp-page="Delete" asp-route-id="@item.Id">彻底删除</a>
                            }
                            else
                            {
                                @if (isRevealed)
                                {
                                    <a asp-page="Index" asp-route-query="@Model.Query" asp-route-group="@Model.Group">隐藏</a>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Reveal"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="query" value="@Model.Query" /><input type="hidden" name="group" value="@Model.Group" /><button type="submit">显示</button></form>
                                }
                                <a asp-page="Edit" asp-route-id="@item.Id">编辑</a>
                                <a asp-page="Details" asp-route-id="@item.Id">详情</a>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="copy-toast" data-copy-toast role="status" aria-live="polite" hidden>复制成功</div>
    <p class="ui-help ui-footnote">显示、复制、修改和删除都会校验当前用户权限；显示与复制动作会写入安全审计，但不会记录明文。</p>
}
