@page "{id:guid}"
@model MyKeyVault.Vault.Pages.Vault.EditModel
@{ ViewData["Title"] = "编辑条目"; }

<a class="ui-breadcrumb" asp-page="Details" asp-route-id="@Model.Input.Id">← 返回条目</a>
<header class="ui-page-head">
    <div>
        <h1>编辑条目</h1>
        <p>名称、网址和加密字段都在这一页修改，保存后返回详情。</p>
    </div>
</header>

<form method="post" class="ui-form ui-card ui-form-card ui-form-wide">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="validation validation-summary ui-notice ui-notice-danger" role="alert"></div>
    }
    <input type="hidden" name="Input.Id" value="@Model.Input.Id" />

    <section class="ui-form-section">
        <div class="ui-section-head"><div><h2>基本信息</h2><p>用于查找和分类，不会作为敏感内容展示。</p></div></div>
        <div class="ui-form-grid">
            <label class="ui-field"><span class="ui-label">名称</span><input asp-for="Input.Title" autocomplete="off" /><span asp-validation-for="Input.Title" class="validation"></span></label>
            <label class="ui-field"><span class="ui-label">类型</span><select asp-for="Input.Kind">
                <option value="Login">登录账号</option><option value="BankCard">银行卡</option><option value="CreditCard">信用卡</option><option value="SecureNote">私密笔记</option>
                <option value="ApiKey">API Key</option><option value="Server">服务器</option><option value="Database">数据库</option><option value="BlockchainAccount">链上账户</option>
            </select></label>
            <label class="ui-field ui-span-2"><span class="ui-label">网址或主机（可选）</span><input asp-for="Input.UrlOrHost" autocomplete="url" inputmode="url" /><span asp-validation-for="Input.UrlOrHost" class="validation"></span></label>
        </div>
    </section>

    <section class="ui-form-section">
        <div class="ui-section-head"><div><h2>加密内容</h2><p>@Model.Input.Secrets.Count 个字段，均可直接修改。</p></div></div>
        <div class="ui-form-grid">
            @for (var i = 0; i < Model.Input.Secrets.Count; i++)
            {
                <input type="hidden" name="Input.Secrets[@i].Id" value="@Model.Input.Secrets[i].Id" />
                <input type="hidden" name="Input.Secrets[@i].FieldName" value="@Model.Input.Secrets[i].FieldName" />
                if (Model.Input.Secrets[i].IsLongText)
                {
                    <label class="ui-field ui-span-2"><span class="ui-label">@Model.Input.Secrets[i].FieldName @if (Model.Input.Secrets[i].IsNew) { <span class="ui-help">可选</span> }</span><textarea asp-for="Input.Secrets[i].Value" autocomplete="off" spellcheck="false"></textarea><span asp-validation-for="Input.Secrets[i].Value" class="validation"></span></label>
                }
                else
                {
                    <label class="ui-field"><span class="ui-label">@Model.Input.Secrets[i].FieldName @if (Model.Input.Secrets[i].IsNew) { <span class="ui-help">可选</span> }</span><input asp-for="Input.Secrets[i].Value" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" inputmode="@Model.Input.Secrets[i].InputMode" /><span asp-validation-for="Input.Secrets[i].Value" class="validation"></span></label>
                }
            }
            <p class="ui-note ui-span-2">这些值只在当前编辑页临时显示；保存时会使用新的随机数据密钥重新加密。</p>
        </div>
    </section>

    <details class="ui-details">
        <summary>标签与收藏（可选）</summary>
        <div>
            <div class="ui-form-grid">
                <label class="ui-field"><span class="ui-label">标签</span><input asp-for="Input.TagsInput" autocomplete="off" placeholder="例如：工作, 个人" /><span class="ui-help">用逗号分隔，仅自己可见。</span><span asp-validation-for="Input.TagsInput" class="validation"></span></label>
                <label class="ui-check"><input asp-for="Input.IsFavorite" /> 优先显示这个条目</label>
            </div>
        </div>
    </details>
    <div class="ui-form-actions">
        <a class="ui-cancel" asp-page="Details" asp-route-id="@Model.Input.Id">取消</a>
        <span class="ui-help">所有修改一次保存</span>
        <button class="ui-btn ui-btn-primary" type="submit">保存修改</button>
    </div>
</form>
