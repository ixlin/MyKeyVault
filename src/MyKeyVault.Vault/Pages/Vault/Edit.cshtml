@page "{id:guid}"
@model MyKeyVault.Vault.Pages.Vault.EditModel
@{ ViewData["Title"] = "编辑条目"; }
<section class="form-heading"><p class="eyebrow">EDIT RECORD</p><h1>编辑条目</h1><p>修改名称、类型、地址和标签不会展示或改写加密字段。</p></section>
<form method="post" class="vault-form"><div asp-validation-summary="ModelOnly" class="validation"></div><input type="hidden" asp-for="Input.Id" />
<div class="composer-grid"><label>条目名称<input asp-for="Input.Title" autocomplete="off" /></label><label>类型<select asp-for="Input.Kind"><option value="Login">登录账号</option><option value="BankCard">银行卡</option><option value="CreditCard">信用卡</option><option value="SecureNote">私密笔记</option><option value="ApiKey">API Key</option><option value="Server">服务器</option><option value="Database">数据库</option><option value="BlockchainAccount">链上账户</option></select></label><label class="span-2">网址或主机<input asp-for="Input.UrlOrHost" autocomplete="url" /></label><label>标签<input asp-for="Input.TagsInput" autocomplete="off" /></label><label class="check"><input asp-for="Input.IsFavorite" /> 优先显示这个条目</label></div><div class="form-actions"><a asp-page="Details" asp-route-id="@Model.Input.Id">取消</a><button class="button" type="submit">保存修改</button></div></form>
