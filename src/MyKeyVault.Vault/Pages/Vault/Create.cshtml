@page
@model MyKeyVault.Vault.Pages.Vault.CreateModel
@{
    ViewData["Title"] = "新增条目";
}
<header class="ui-page-head">
    <div>
        <h1>新增条目</h1>
        <p>名称和网址用于查找；账号、卡号、密码与备注会分别加密。</p>
    </div>
</header>
<form method="post" class="ui-form ui-card ui-form-card ui-form-wide">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="validation validation-summary ui-notice ui-notice-danger" role="alert"></div>
    }
    <section class="ui-form-section">
        <div class="ui-section-head"><div><h2>基本信息</h2><p>用于列表识别，不要在名称中写密码或卡号。</p></div></div>
        <div class="ui-form-grid">
            <label class="ui-field"><span class="ui-label">名称</span><input asp-for="Input.Title" autocomplete="off" placeholder="例如：Apple 账号、招商银行信用卡" /><span asp-validation-for="Input.Title" class="validation"></span></label>
            <label class="ui-field"><span class="ui-label">类型</span><select asp-for="Input.Kind" data-vault-kind>
                <option value="Login">登录账号</option><option value="BankCard">银行卡</option><option value="CreditCard">信用卡</option><option value="SecureNote">私密笔记</option>
                <optgroup label="更多类型"><option value="ApiKey">API Key</option><option value="Server">服务器</option><option value="Database">数据库</option><option value="BlockchainAccount">链上账户</option></optgroup>
            </select></label>
            <label class="ui-field ui-span-2"><span class="ui-label">网址或主机（可选）</span><input asp-for="Input.UrlOrHost" inputmode="url" autocomplete="url" placeholder="https://example.com" /><span asp-validation-for="Input.UrlOrHost" class="validation"></span></label>
        </div>
    </section>
    <section class="ui-form-section">
        <div class="ui-section-head"><div><h2>加密内容</h2><p>每项使用独立数据密钥加密，明文不会写入日志。</p></div></div>
        <div class="ui-form-grid">
            <label class="ui-field" data-account-field><span class="ui-label" data-field-label>账号信息</span><input asp-for="Input.AccountValue" autocomplete="username" placeholder="用户名、邮箱或登录账号" /><span asp-validation-for="Input.AccountValue" class="validation"></span></label>
            <label class="ui-field" data-secret-field><span class="ui-label" data-field-label>密码或密钥</span><input asp-for="Input.SecretValue" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="输入密码或其它私密凭据" /><span asp-validation-for="Input.SecretValue" class="validation"></span></label>
            <div class="ui-card-fields ui-span-2" data-card-fields hidden>
                <label class="ui-field"><span class="ui-label">持卡人姓名（可选）</span><input asp-for="Input.CardholderName" autocomplete="off" placeholder="卡面姓名" /><span asp-validation-for="Input.CardholderName" class="validation"></span></label>
                <label class="ui-field"><span class="ui-label">有效期（可选）</span><input asp-for="Input.Expiry" autocomplete="off" inputmode="numeric" placeholder="MM / YY" /><span asp-validation-for="Input.Expiry" class="validation"></span></label>
                <label class="ui-field"><span class="ui-label">安全码 CVV/CVC（可选）</span><input asp-for="Input.SecurityCode" type="text" autocomplete="off" inputmode="numeric" autocapitalize="off" spellcheck="false" placeholder="卡背面 3 位或正面 4 位" /><span asp-validation-for="Input.SecurityCode" class="validation"></span></label>
                <label class="ui-field"><span class="ui-label">PIN / 取款密码（可选）</span><input asp-for="Input.Pin" type="text" autocomplete="off" inputmode="numeric" autocapitalize="off" spellcheck="false" placeholder="仅在确有需要时保存" /><span asp-validation-for="Input.Pin" class="validation"></span></label>
            </div>
            <label class="ui-field ui-span-2" data-notes-field><span class="ui-label" data-field-label>备注</span><textarea asp-for="Input.Notes" autocomplete="off" spellcheck="false" placeholder="登录方式、用途、补充说明等，都写在这里"></textarea><span asp-validation-for="Input.Notes" class="validation"></span></label>
            <p class="ui-note ui-span-2" data-card-safety hidden><strong>高敏信息：</strong>安全码和 PIN 会分别加密并默认遮蔽。请只保存在自己的保险库中，不要保存短信验证码或会不断变化的动态口令。</p>
        </div>
    </section>
    <details class="ui-details">
        <summary>标签与收藏（可选）</summary>
        <div>
            <div class="ui-form-grid">
                <label class="ui-field"><span class="ui-label">标签</span><input asp-for="Input.TagsInput" autocomplete="off" placeholder="例如：工作, 个人" /><span class="ui-help">用逗号分隔，仅自己可见。</span><span asp-validation-for="Input.TagsInput" class="validation"></span></label>
                <label class="ui-check"><input asp-for="Input.IsFavorite" /> 优先显示这个条目</label>
            </div>
        </div>
    </details>
    <div class="ui-form-actions">
        <a class="ui-cancel" asp-page="Index">取消</a>
        <span class="ui-help">至少填写一项加密内容</span>
        <button class="ui-btn ui-btn-primary" type="submit">加密保存</button>
    </div>
</form>
