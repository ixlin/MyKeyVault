@using Microsoft.AspNetCore.Identity
@using MyKeyVault.Vault.Models
@inject SignInManager<VaultUser> SignInManager
@inject UserManager<VaultUser> UserManager

<ul class="identity-links">
@if (SignInManager.IsSignedIn(User))
{
    <li><a asp-area="Identity" asp-page="/Account/Manage/Index" title="管理账户">@UserManager.GetUserName(User)</a></li>
    <li><form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post"><button type="submit" class="text-button">退出</button></form></li>
}
else
{
    <li><a asp-area="Identity" asp-page="/Account/Register">注册</a></li>
    <li><a asp-area="Identity" asp-page="/Account/Login">登录</a></li>
}
</ul>
