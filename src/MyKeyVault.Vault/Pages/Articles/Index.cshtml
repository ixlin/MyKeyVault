@page
@model MyKeyVault.Vault.Pages.Articles.IndexModel
@{ ViewData["Title"] = "公众号资料库"; }
<header class="ui-page-head">
    <div>
        <h1>公众号资料库</h1>
        <p>收藏原文，查看抓取进度，围绕每篇文章展开对话。</p>
    </div>
    <div class="ui-page-actions">
        <a class="ui-btn ui-btn-ghost" asp-page="Settings">@(Model.AiConfigured ? "萃取模型设置" : "配置萃取模型")</a>
    </div>
</header>
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="ui-notice ui-notice-ok" role="status">@Model.Notice</div> }

<section class="ui-capture">
    <div>
        <h2>添加文章</h2>
        <p>粘贴公众号链接，每行一条，最多 10 篇。已收录或正在抓取的链接会跳过。</p>
    </div>
    <form method="post" data-capture-form>
        <textarea asp-for="Urls" maxlength="6000" required placeholder="https://mp.weixin.qq.com/s/..." aria-label="微信公众号文章链接"></textarea>
        <span asp-validation-for="Urls" class="validation"></span>
        <div class="ui-capture-foot">
            <span class="ui-service"><i class="ui-service-dot @(Model.ScraperAvailable ? null : "is-off")"></i>@(Model.ScraperAvailable ? "抓取服务正常" : "服务暂不可用，请稍后重试")</span>
            <button class="ui-btn ui-btn-primary" type="submit" disabled="@(!Model.ScraperAvailable)">开始抓取</button>
        </div>
    </form>
</section>

<section id="library" data-article-library data-progress-url="@Url.Page("Index", "Progress", new { Model.Search, Model.PageNumber })">
    <div class="ui-toolbar ui-library-toolbar">
        <div class="ui-section-title"><h2>文章 <span class="ui-muted ui-small">@Model.TotalCount 篇</span></h2></div>
        <form method="get" class="ui-search" role="search">
            <input asp-for="Search" placeholder="搜索标题或公众号" aria-label="搜索文章" maxlength="100" />
            <button type="submit">搜索</button>
        </form>
    </div>
    <p data-progress-notice class="ui-help" role="status"></p>

    @if (Model.Articles.Count == 0)
    {
        <div class="ui-empty">
            <span class="ui-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v18H6.5A2.5 2.5 0 0 1 4 18.5z"/><path d="M4 17.5h16"/></svg></span>
            <h2>@(string.IsNullOrEmpty(Model.Search) ? "资料库还是空的" : "没有找到文章")</h2>
            <p>粘贴公众号链接添加文章，或换个关键词搜索。</p>
        </div>
    }
    else
    {
        <div class="ui-article-list">
        @foreach (var article in Model.Articles)
        {
            var active = article.Status is "pending" or "processing";
            var statusText = article.Status == "completed" ? "已收录" : article.Status == "failed" ? "失败" : article.Status == "cancelled" ? "已取消" : "处理中";
            <article class="ui-article" data-article-id="@article.Id" data-state="@article.Status">
                <div class="ui-article-head">
                    <div>
                        <a class="ui-article-title" asp-page="Details" asp-route-id="@article.Id" data-article-title>@(article.Title ?? (active ? "正在获取文章标题…" : "抓取未完成"))</a>
                        <p class="ui-article-meta">
                            <span data-article-author>@(article.Author ?? "公众号文章")</span>
                            <span>@article.CreatedAtUtc.ToLocalTime().ToString("MM-dd HH:mm")</span>
                            <span data-article-resources>@article.Images 张图片 · @article.ExtractionCount 次萃取</span>
                        </p>
                    </div>
                    <span class="status-pill status-@article.Status" data-article-state>@statusText</span>
                </div>
                <div class="ui-article-actions">
                    @if (!string.IsNullOrWhiteSpace(article.PreviewUrl))
                    {
                        <a class="ui-btn ui-btn-ghost ui-btn-sm" href="@article.PreviewUrl" target="_blank" rel="noopener" aria-label="阅读《@article.Title》原文">阅读原文</a>
                    }
                    else if (!string.IsNullOrWhiteSpace(article.SourceUrl))
                    {
                        <a class="ui-btn ui-btn-ghost ui-btn-sm" href="@article.SourceUrl" target="_blank" rel="noopener noreferrer" aria-label="阅读《@article.Title》原文">阅读原文</a>
                    }
                    <a class="ui-btn ui-btn-primary ui-btn-sm" asp-page="Details" asp-route-id="@article.Id">AI 萃取</a>
                    <form method="post" asp-page-handler="Retry" data-retry hidden="@(article.Status is not ("failed" or "cancelled"))">
                        <input type="hidden" name="id" value="@article.Id" />
                        <button type="submit" class="text-button">重新抓取</button>
                    </form>
                </div>
                <div class="ui-progress" data-progress-block hidden="@(!active)">
                    <progress max="100" value="@article.Progress" aria-label="文章抓取进度"></progress>
                    <span data-stage>@article.Stage · @article.Progress%</span>
                </div>
                <p class="validation" data-article-error hidden="@(string.IsNullOrEmpty(article.Error))">@article.Error</p>
                <details class="ui-process">
                    <summary>处理过程</summary>
                    <ol data-process-log>@foreach (var entry in article.Logs) { <li><time>@entry.Time.Replace('T', ' ')</time><span>@entry.Message</span><small>@entry.Progress%</small></li> }</ol>
                    <p data-no-log hidden="@(article.Logs.Count > 0)">@(active ? "任务已排队，开始后会显示各阶段进度。" : "历史任务没有保存详细过程；新的抓取任务会记录。")</p>
                </details>
            </article>
        }
        </div>
        <nav class="ui-pagination" aria-label="文章翻页">
            @if (Model.PageNumber > 1) { <a asp-page="Index" asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.PageNumber - 1)">上一页</a> }
            <span>第 @Model.PageNumber / @Model.TotalPages 页</span>
            @if (Model.PageNumber < Model.TotalPages) { <a asp-page="Index" asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.PageNumber + 1)">下一页</a> }
        </nav>
    }
</section>
@section Scripts { <script src="~/js/articles.js" asp-append-version="true" defer></script> }
