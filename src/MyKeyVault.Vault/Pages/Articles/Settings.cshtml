@page
@model MyKeyVault.Vault.Pages.Articles.SettingsModel
@{ ViewData["Title"] = "萃取模型设置"; }
<a class="ui-breadcrumb" asp-page="/Settings/Index">← 返回设置</a>
<header class="ui-page-head">
    <div>
        <h1>萃取模型设置</h1>
        <p>支持 DeepSeek、OpenAI 及兼容 Chat Completions 的 HTTPS 服务。</p>
    </div>
</header>
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="ui-notice ui-notice-ok" role="status">@Model.Notice</div> }
<div class="ui-settings-grid">
    <form method="post" class="ui-form ui-card ui-form-card">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="validation ui-notice ui-notice-danger" role="alert"></div>
        }
        <div class="ui-form-grid">
            <label class="ui-field"><span class="ui-label">提供商</span><input asp-for="Input.Provider" autocomplete="off" placeholder="deepseek" /><span asp-validation-for="Input.Provider" class="validation"></span></label>
            <label class="ui-field"><span class="ui-label">模型名称</span><input asp-for="Input.ModelName" autocomplete="off" /><span asp-validation-for="Input.ModelName" class="validation"></span></label>
            <label class="ui-field ui-span-2"><span class="ui-label">API Base URL</span><input asp-for="Input.BaseUrl" inputmode="url" autocomplete="url" /><span asp-validation-for="Input.BaseUrl" class="validation"></span></label>
            <label class="ui-field ui-span-2"><span class="ui-label">API Key</span><input asp-for="Input.ApiKey" type="password" autocomplete="new-password" placeholder="@(Model.HasApiKey ? "已加密保存；留空则不修改" : "输入 API Key")" /><span class="ui-help">Key 仅在发起萃取请求时短暂解密，不会显示在页面或日志中。</span><span asp-validation-for="Input.ApiKey" class="validation"></span></label>
        </div>
        <div class="ui-form-actions">
            <a class="ui-cancel" asp-page="Index">返回资料库</a>
            <button class="ui-btn ui-btn-primary" type="submit">保存配置</button>
        </div>
    </form>
    <aside class="ui-card">
        <div class="ui-card-head"><h2>加密存储</h2></div>
        <div class="ui-card-body">
            <p class="ui-help">每个 API Key 使用独立随机数据密钥和 AES-256-GCM 加密；数据密钥再由部署主密钥包裹。数据库中不保存 API Key 明文。</p>
        </div>
    </aside>
</div>
