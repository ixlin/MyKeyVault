@page
@model ForgotPasswordModel
@{ ViewData["Title"] = "重置密码"; }
<section class="auth-page recovery-page">
    <div class="auth-intro">
        <h1>找回登录权限</h1>
        <p>用注册邮箱验证身份，重新设置登录密码。保险库里的条目和加密数据不会改变。</p>
        <p class="recovery-help">验证码 10 分钟内有效，仅能使用一次。重置成功后，账号临时锁定会解除，其他设备的登录会在一分钟内失效。</p>
    </div>
    <div class="auth-card recovery-card">
        @if (!Model.EmailReady) { <div class="notice" role="status">邮件服务尚未配置，暂时无法发送验证码，请联系管理员。</div> }
        @if (Model.StatusMessage is not null) { <div class="notice" role="status">@Model.StatusMessage</div> }
        <form method="post" asp-page-handler="Reset" class="recovery-form">
            <div asp-validation-summary="All" class="validation" role="alert"></div>
            <label for="Input_Email">注册邮箱</label>
            <div class="recovery-send"><input asp-for="Input.Email" type="email" autocomplete="email" inputmode="email" maxlength="254" required placeholder="you@example.com" /><button class="button" type="submit" asp-page-handler="Send" formnovalidate disabled="@(!Model.EmailReady)">发送验证码</button></div>
            <label>邮件验证码<input asp-for="Input.Code" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required placeholder="6 位数字" /></label>
            <label>新密码<input asp-for="Input.Password" autocomplete="new-password" minlength="12" maxlength="128" required /></label>
            <p class="recovery-help">至少 12 个字符，包含大写、小写字母、数字和符号。</p>
            <label>确认新密码<input asp-for="Input.ConfirmPassword" autocomplete="new-password" minlength="12" maxlength="128" required /></label>
            <button class="button" type="submit">验证并重置密码</button>
        </form>
        <p class="auth-switch"><a asp-page="./Login">返回登录</a></p>
    </div>
</section>
