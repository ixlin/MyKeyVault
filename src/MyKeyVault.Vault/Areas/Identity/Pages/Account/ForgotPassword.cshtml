@page
@model ForgotPasswordModel
@{ ViewData["Title"] = "重置密码"; }
<section class="ui-auth-card ui-auth-wide">
    <h1>重置密码</h1>
    <p class="ui-auth-sub">用注册邮箱验证身份，重新设置登录密码。保险库里的条目不会改变。</p>
    @if (!Model.EmailReady) { <div class="ui-notice ui-notice-warn" role="status">邮件服务尚未配置，暂时无法发送验证码，请联系管理员。</div> }
    @if (Model.StatusMessage is not null) { <div class="ui-notice" role="status">@Model.StatusMessage</div> }
    <form method="post" asp-page-handler="Reset" class="ui-auth-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="validation ui-notice ui-notice-danger" role="alert"></div>
        }
        <div class="ui-field">
            <label class="ui-label" for="Input_Email">注册邮箱</label>
            <div class="ui-auth-row">
                <input asp-for="Input.Email" type="email" autocomplete="email" inputmode="email" maxlength="254" required placeholder="you@example.com" />
                <button class="ui-btn ui-btn-ghost" type="submit" asp-page-handler="Send" formnovalidate disabled="@(!Model.EmailReady)">发送验证码</button>
            </div>
            <span asp-validation-for="Input.Email" class="validation"></span>
        </div>
        <label class="ui-field"><span class="ui-label">邮件验证码</span><input asp-for="Input.Code" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required placeholder="6 位数字" /><span asp-validation-for="Input.Code" class="validation"></span></label>
        <label class="ui-field"><span class="ui-label">新密码</span><input asp-for="Input.Password" autocomplete="new-password" minlength="12" maxlength="128" required /><span class="ui-help">至少 12 个字符，包含大写、小写字母、数字和符号。</span><span asp-validation-for="Input.Password" class="validation"></span></label>
        <label class="ui-field"><span class="ui-label">确认新密码</span><input asp-for="Input.ConfirmPassword" autocomplete="new-password" minlength="12" maxlength="128" required /><span asp-validation-for="Input.ConfirmPassword" class="validation"></span></label>
        <button class="ui-btn ui-btn-primary" type="submit">验证并重置密码</button>
    </form>
    <p class="ui-auth-help">验证码 10 分钟内有效，仅能使用一次。重置成功后，其他设备的登录会在一分钟内失效。</p>
    <p class="ui-auth-links"><a asp-page="./Login">返回登录</a></p>
</section>
