@page
@model LoginModel
@{
    ViewData["Title"] = "登录";
}
<section class="ui-auth-card">
    <h1>登录保险库</h1>
    <p class="ui-auth-sub">用注册邮箱和密码进入你的私人密码本。</p>
    <form method="post" class="ui-auth-form">
        <input type="hidden" asp-for="ReturnUrl" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="validation ui-notice ui-notice-danger" role="alert"></div>
        }
        <label class="ui-field"><span class="ui-label">邮箱地址</span><input asp-for="Input.Email" autocomplete="email" inputmode="email" placeholder="you@example.com" /><span asp-validation-for="Input.Email" class="validation"></span></label>
        <label class="ui-field"><span class="ui-label">密码</span><input asp-for="Input.Password" autocomplete="current-password" placeholder="输入你的密码" /><span asp-validation-for="Input.Password" class="validation"></span></label>
        <label class="ui-check"><input asp-for="Input.RememberMe" /> 在此设备保持登录</label>
        <button class="ui-btn ui-btn-primary" type="submit">登录保险库</button>
    </form>
    <p class="ui-auth-links"><a asp-page="./ForgotPassword">忘记密码？通过邮箱重置</a></p>
    <p class="ui-auth-links">还没有保险库？<a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">创建一个</a></p>
</section>
