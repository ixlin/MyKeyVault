@page
@model MyKeyVault.Web.Areas.Identity.Pages.Account.Manage.PersonalDataModel
@{
    ViewData["Title"] = "个人数据";
}
<h3>个人数据</h3>
<p class="text-muted">你可以导出或删除与该账户相关的个人数据。</p>
<div class="mkv-manage-danger">
  <p class="fw-bold text-danger">删除账户不可恢复。</p>
  <div class="d-flex gap-2 flex-wrap">
    <form method="post" asp-page="DownloadPersonalData" class="d-inline"><button class="btn btn-primary">下载个人数据</button></form>
    <a class="btn btn-danger" asp-page="DeletePersonalData">删除账户</a>
  </div>
</div>
