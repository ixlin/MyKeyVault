@{
    Layout = "/Views/Shared/_Layout.cshtml";
}
<div class="mkv-manage-page">
  <div class="mkv-page-header">
    <div>
      <h1 class="mkv-page-heading">账户管理</h1>
      <p class="mkv-page-description">管理个人资料、登录方式和账户安全。</p>
    </div>
  </div>
  <div class="mkv-manage-layout">
    <aside class="mkv-manage-nav">
        <partial name="_ManageNav" />
    </aside>
    <section class="mkv-manage-content">
        @RenderBody()
    </section>
  </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
