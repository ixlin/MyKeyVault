@{
    ViewData["Title"] = "微信图文";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold" style="color:var(--mkv-navy)">📰 @ViewData["Title"]</h2>
    <a class="mkv-btn-primary" asp-action="TaskManagement" style="padding:0.5rem 1.2rem;font-size:0.9rem;">📋 任务管理</a>
</div>

@if (ViewBag.ServiceAvailable != null && !(bool)ViewBag.ServiceAvailable)
{
<div style="background:#FEF3C7;border-left:3px solid #F59E0B;padding:0.8rem 1rem;border-radius:8px;margin-bottom:1rem;font-size:0.85rem;">
    ⚠️ 爬虫服务暂不可用，部分功能受限
</div>
}

@if (TempData["Success"] != null)
{
<div style="background:#ecfdf5;border-left:3px solid var(--mkv-success);padding:0.8rem 1rem;border-radius:8px;margin-bottom:1rem;font-size:0.85rem;color:var(--mkv-success);">
    ✅ @TempData["Success"]
</div>
}
@if (TempData["Error"] != null)
{
<div style="background:#fef2f2;border-left:3px solid var(--mkv-danger);padding:0.8rem 1rem;border-radius:8px;margin-bottom:1rem;font-size:0.85rem;color:var(--mkv-danger);">
    ❌ @TempData["Error"]
</div>
}

<div id="articles-container">
    @await Html.PartialAsync("Index_body")
</div>