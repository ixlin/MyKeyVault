@model MyKeyVault.Web.Models.Tag
@{
    ViewData["Title"] = "新建标签";
}
<div class="row justify-content-center">
  <div class="col-md-6">
    <div style="background:#fff;border-radius:16px;padding:2rem;box-shadow:var(--mkv-shadow-lg);">
      <h2 class="fw-bold mb-3" style="color:var(--mkv-navy);">🏷️ @ViewData["Title"]</h2>
      <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
          <label asp-for="TagName" class="fw-semibold" style="color:var(--mkv-navy);font-size:0.9rem;">标签名称</label>
          <input asp-for="TagName" class="form-control" placeholder="如：社交、支付、工作" style="border-radius:10px;border:1.5px solid var(--mkv-border);padding:0.6rem 0.8rem;" />
          <span asp-validation-for="TagName" class="text-danger"></span>
        </div>
        <div style="display:flex;gap:10px;">
          <button type="submit" class="mkv-btn-primary">创建</button>
          <a asp-action="Index" class="mkv-btn-outline">取消</a>
        </div>
      </form>
    </div>
  </div>
</div>