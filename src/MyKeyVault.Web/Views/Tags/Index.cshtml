@model IEnumerable<MyKeyVault.Web.Models.Tag>
@{
    ViewData["Title"] = "标签管理";
}
<div class="mkv-page-header">
    <div>
        <h1 class="mkv-page-heading">标签管理</h1>
        <p class="mkv-page-description">用标签快速筛选和整理账号库。</p>
    </div>
    <a class="mkv-btn-primary" asp-action="Create">+ 新建标签</a>
</div>

@if (Model != null && Model.Any())
{
<div style="display:flex;flex-wrap:wrap;gap:10px;">
    @foreach (var tag in Model)
    {
    <div style="background:#fff;border-radius:12px;padding:1rem 1.25rem;box-shadow:var(--mkv-shadow);display:flex;align-items:center;gap:0.75rem;border-left:3px solid var(--mkv-gold);">
        <span style="font-weight:600;color:var(--mkv-navy);">@tag.TagName</span>
        <span style="font-size:0.78rem;color:var(--mkv-text-muted);background:var(--mkv-bg);padding:0.15rem 0.5rem;border-radius:20px;">@(tag.AccountTags?.Count ?? 0) 个账号</span>
        <div style="display:flex;gap:4px;">
            <a asp-action="Edit" asp-route-id="@tag.TagId" style="padding:0.25rem 0.6rem;font-size:0.78rem;border-radius:6px;background:var(--mkv-gold-light);color:var(--mkv-gold);text-decoration:none;font-weight:600;">编辑</a>
            <a asp-action="Delete" asp-route-id="@tag.TagId" style="padding:0.25rem 0.6rem;font-size:0.78rem;border-radius:6px;border:1px solid var(--mkv-danger);color:var(--mkv-danger);text-decoration:none;">删除</a>
        </div>
    </div>
    }
</div>
}
else
{
<div class="mkv-empty" style="background:#fff;border-radius:var(--mkv-radius);padding:3rem;box-shadow:var(--mkv-shadow);">
    还没有标签，<a asp-action="Create">创建第一个标签</a>
</div>
}
