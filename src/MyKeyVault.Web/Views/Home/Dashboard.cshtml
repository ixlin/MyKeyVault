@{
    ViewData["Title"] = "概览";
    var totalAccounts = (int)(ViewBag.TotalAccounts ?? 0);
    var totalTags = (int)(ViewBag.TotalTags ?? 0);
    var recent = ViewBag.Recent as IEnumerable<dynamic>;
}
<div class="mkv-dashboard-header">
    <h2>👋 控制台概览</h2>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="mkv-stat-card">
            <div class="stat-label">账号总数</div>
            <div class="stat-value">@totalAccounts</div>
            <a class="stat-link" href="/VaultAccounts/Create">+ 新增账号</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mkv-stat-card">
            <div class="stat-label">标签总数</div>
            <div class="stat-value">@totalTags</div>
            <a class="stat-link" href="/Tags">管理标签</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mkv-stat-card">
            <div class="stat-label">微信图文</div>
            <div class="stat-value" style="font-size:1.4rem;padding-top:0.4rem;">抓取与管理</div>
            <a class="stat-link" href="/WechatArticle">查看图文</a>
        </div>
    </div>
</div>

<div class="mkv-recent-section">
    <h4>最近修改账号</h4>
    @if (recent != null && recent.Any())
    {
        <ul class="mkv-recent-list">
            @foreach (var a in recent)
            {
                <li>
                    <a class="mkv-recent-item" href="/VaultAccounts/Edit/@a.AccountId">
                        <div>
                            <div class="item-title">@a.Title</div>
                            <div class="item-url">@a.Url</div>
                        </div>
                        <div class="item-time">@a.UpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")</div>
                    </a>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="mkv-empty">
            暂无数据，<a href="/VaultAccounts/Create">创建第一个账号</a> 开始使用
        </div>
    }
</div>