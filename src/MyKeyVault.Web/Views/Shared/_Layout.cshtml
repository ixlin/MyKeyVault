<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 我的密码本</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyKeyVault.Web.styles.css" asp-append-version="true" />
</head>
@{
    var isSignedIn = User?.Identity?.IsAuthenticated == true;
    var isAdmin = isSignedIn && (User?.IsInRole("Admin") == true);
}
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark mkv-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px;margin-right:6px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/></svg>
                    我的密码本
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (isSignedIn)
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">概览</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="VaultAccounts" asp-action="Index">账号库</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="WechatArticle" asp-action="Index">微信图文</a></li>
                            @if (isAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">管理与数据</a>
                                    <ul class="dropdown-menu dropdown-menu-dark">
                                        <li><a class="dropdown-item" asp-controller="TushareManagement" asp-action="Apps">上市公司数据</a></li>
                                        <li><a class="dropdown-item" asp-controller="WechatArticle" asp-action="AIConfig">微信图文配置</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 py-3 mkv-app-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="mkv-footer">
        <div>&copy; 2026 我的密码本 · AI实现 · <a href="https://beian.miit.gov.cn/" target="_blank">蜀ICP备2024053184号-5</a></div>
    </footer>

    <script>
        window.__isAuthenticated = @(User?.Identity?.IsAuthenticated == true ? "true" : "false");
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
