@model IEnumerable<MyKeyVault.Web.Models.VaultAccount>
@{
    ViewData["Title"] = "账号管理";
}
<form id="af-form" class="d-none">@Html.AntiForgeryToken()</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold" style="color:var(--mkv-navy)">📋 @ViewData["Title"]</h2>
    <a class="mkv-btn-primary" asp-action="Create" style="padding:0.5rem 1.5rem;font-size:0.9rem;">+ 新增账号</a>
</div>

@{
    var allTags = ViewBag.AllTags as IEnumerable<MyKeyVault.Web.Models.Tag>;
    var counts = ViewBag.TagCounts as Dictionary<long,int>;
    long? currentTagId = ViewData["tagId"] as long?;
}

@if (allTags != null)
{
<div class="mb-3" style="display:flex;flex-wrap:wrap;gap:6px;">
    <a href="@Url.Action("Index", new { q = ViewData["q"], tagId = (long?)null })"
       style="padding:0.35rem 0.9rem;border-radius:20px;font-size:0.82rem;font-weight:600;text-decoration:none;@(currentTagId==null?"background:var(--mkv-gold);color:var(--mkv-navy)":"background:#fff;color:var(--mkv-text-muted);border:1px solid var(--mkv-border)")">
        全部
    </a>
    @foreach (var t in allTags)
    {
        var c = (counts!=null && counts.ContainsKey(t.TagId)) ? counts[t.TagId] : 0;
        <a href="@Url.Action("Index", new { q = ViewData["q"], tagId = t.TagId })"
           style="padding:0.35rem 0.9rem;border-radius:20px;font-size:0.82rem;font-weight:600;text-decoration:none;@(currentTagId==t.TagId?"background:var(--mkv-gold);color:var(--mkv-navy)":"background:#fff;color:var(--mkv-text-muted);border:1px solid var(--mkv-border)")">
            @t.TagName <span style="opacity:0.6">@c</span>
        </a>
    }
</div>
}

<form class="row g-2 align-items-end mb-3" style="background:#fff;padding:1rem;border-radius:var(--mkv-radius);box-shadow:var(--mkv-shadow);">
    <div class="col-auto" style="flex:1;min-width:180px;">
        <label style="font-size:0.75rem;color:var(--mkv-text-muted);margin-bottom:2px;">搜索</label>
        <input type="text" name="q" value="@ViewData["q"]" class="form-control" placeholder="标题 / URL" style="border-radius:8px;border:1.5px solid var(--mkv-border);">
    </div>
    <div class="col-auto">
        <label style="font-size:0.75rem;color:var(--mkv-text-muted);margin-bottom:2px;">开始日期</label>
        <input type="date" name="createdFrom" value="@ViewData["createdFrom"]" class="form-control" style="border-radius:8px;border:1.5px solid var(--mkv-border);">
    </div>
    <div class="col-auto">
        <label style="font-size:0.75rem;color:var(--mkv-text-muted);margin-bottom:2px;">结束日期</label>
        <input type="date" name="createdTo" value="@ViewData["createdTo"]" class="form-control" style="border-radius:8px;border:1.5px solid var(--mkv-border);">
    </div>
    <div class="col-auto">
        <button class="mkv-btn-primary" type="submit" style="padding:0.45rem 1.2rem;font-size:0.85rem;">🔍 搜索</button>
    </div>
</form>

<form id="bulkDeleteForm" method="post" asp-action="BulkDelete">
    @Html.AntiForgeryToken()
    <input type="hidden" name="q" value="@ViewData["q"]" />
    <input type="hidden" name="tagId" value="@ViewData["tagId"]" />
    <input type="hidden" name="createdFrom" value="@ViewData["createdFrom"]" />
    <input type="hidden" name="createdTo" value="@ViewData["createdTo"]" />
    <input type="hidden" name="sort" value="@ViewData["sort"]" />
    <input type="hidden" name="dir" value="@ViewData["dir"]" />

<div class="d-flex justify-content-between mb-2" style="gap:8px;">
    <div>
        <button type="submit" class="btn btn-sm" style="background:var(--mkv-danger);color:#fff;border-radius:8px;" onclick="return confirm('确定批量删除选中的账号？此操作不可恢复。');" disabled id="bulkDeleteBtn">🗑 批量删除</button>
        <button type="button" class="btn btn-sm" style="border:1.5px solid var(--mkv-border);border-radius:8px;color:var(--mkv-text-muted);" id="selectAllBtn">全选</button>
        <button type="button" class="btn btn-sm" style="border:1.5px solid var(--mkv-border);border-radius:8px;color:var(--mkv-text-muted);" id="invertSelectBtn">反选</button>
    </div>
</div>

<div class="table-responsive">
<table class="table" style="background:#fff;border-radius:var(--mkv-radius);overflow:hidden;box-shadow:var(--mkv-shadow);">
    <thead style="background:var(--mkv-bg);">
        <tr>
            <th style="width:40px;">#</th>
            <th>@{
                var sort = (ViewData["sort"] as string) ?? "updated";
                var dir = (ViewData["dir"] as string) ?? "desc";
            }
            <a href="@Url.Action("Index", new { q=ViewData["q"], tagId=ViewData["tagId"], createdFrom=ViewData["createdFrom"], createdTo=ViewData["createdTo"], sort="title", dir=sort=="title"&&dir=="asc"?"desc":"asc" })" style="color:var(--mkv-navy);text-decoration:none;">标题</a></th>
            <th>URL</th>
            <th>账号</th>
            <th>密码</th>
            <th><a href="@Url.Action("Index", new { q=ViewData["q"], tagId=ViewData["tagId"], createdFrom=ViewData["createdFrom"], createdTo=ViewData["createdTo"], sort="created", dir=sort=="created"&&dir=="asc"?"desc":"asc" })" style="color:var(--mkv-navy);text-decoration:none;">创建</a></th>
            <th><a href="@Url.Action("Index", new { q=ViewData["q"], tagId=ViewData["tagId"], createdFrom=ViewData["createdFrom"], createdTo=ViewData["createdTo"], sort="updated", dir=sort=="updated"&&dir=="asc"?"desc":"asc" })" style="color:var(--mkv-navy);text-decoration:none;">修改</a></th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td><input type="checkbox" name="selectedIds" value="@item.AccountId" class="sel-chk" /></td>
            <td style="font-weight:600;color:var(--mkv-navy);">@item.Title</td>
            <td style="color:var(--mkv-text-muted);font-size:0.85rem;">@item.Url</td>
            <td>@item.AccountNameEncrypted</td>
            <td>@item.PasswordEncrypted</td>
            <td style="font-size:0.82rem;color:var(--mkv-text-muted);">@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
            <td style="font-size:0.82rem;color:var(--mkv-text-muted);">@item.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
            <td>
                <div style="display:flex;gap:4px;">
                    <a class="btn btn-sm" style="border:1.5px solid var(--mkv-border);border-radius:8px;color:var(--mkv-text-muted);" asp-action="Details" asp-route-id="@item.AccountId">详情</a>
                    <a class="btn btn-sm" style="background:var(--mkv-gold-light);border-radius:8px;color:var(--mkv-gold);font-weight:600;" asp-action="Edit" asp-route-id="@item.AccountId">编辑</a>
                    <a class="btn btn-sm" style="border:1.5px solid var(--mkv-danger);border-radius:8px;color:var(--mkv-danger);" asp-action="Delete" asp-route-id="@item.AccountId">删除</a>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
</form>

<script>
    (function(){
        var bulkBtn = document.getElementById('bulkDeleteBtn');
        var chks = function(){ return Array.from(document.querySelectorAll('.sel-chk')); };
        function refresh(){
            var any = chks().some(function(c){return c.checked;});
            bulkBtn.disabled = !any;
        }
        document.getElementById('selectAllBtn').addEventListener('click', function(){ chks().forEach(function(c){c.checked=true;}); refresh(); });
        document.getElementById('invertSelectBtn').addEventListener('click', function(){ chks().forEach(function(c){c.checked=!c.checked;}); refresh(); });
        chks().forEach(function(c){c.addEventListener('change', refresh);});
    })();
</script>