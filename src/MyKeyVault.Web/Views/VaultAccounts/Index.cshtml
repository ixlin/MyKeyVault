@model IEnumerable<MyKeyVault.Web.Models.VaultAccount>
@{
    ViewData["Title"] = "账号管理";
}
<form id="af-form" class="d-none">@Html.AntiForgeryToken()</form>

<div class="mkv-page-header">
    <div>
        <h1 class="mkv-page-heading">账号库</h1>
        <p class="mkv-page-description">查找、整理并维护你的常用登录信息。</p>
    </div>
    <a class="mkv-btn-primary" asp-action="Create">+ 新增账号</a>
</div>

@{
    var allTags = ViewBag.AllTags as IEnumerable<MyKeyVault.Web.Models.Tag>;
    var counts = ViewBag.TagCounts as Dictionary<long,int>;
    long? currentTagId = ViewData["tagId"] as long?;
}

@if (allTags != null)
{
<div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
    <a href="@Url.Action("Index", new { q = ViewData["q"], tagId = (long?)null })"
       class="mkv-chip @(currentTagId == null ? "is-active" : "")">
        全部
    </a>
    @foreach (var t in allTags)
    {
        var c = (counts!=null && counts.ContainsKey(t.TagId)) ? counts[t.TagId] : 0;
        <a href="@Url.Action("Index", new { q = ViewData["q"], tagId = t.TagId })"
           class="mkv-chip @(currentTagId == t.TagId ? "is-active" : "")">
            @t.TagName <span style="opacity:0.6">@c</span>
        </a>
    }
</div>
}

<form class="mkv-panel mkv-panel-body mkv-toolbar mb-3">
    <div class="mkv-field" style="flex:1 1 220px;">
        <label>搜索</label>
        <input type="text" name="q" value="@ViewData["q"]" class="form-control" placeholder="搜索标题或网址">
    </div>
    <div class="mkv-field">
        <label>开始日期</label>
        <input type="date" name="createdFrom" value="@ViewData["createdFrom"]" class="form-control">
    </div>
    <div class="mkv-field">
        <label>结束日期</label>
        <input type="date" name="createdTo" value="@ViewData["createdTo"]" class="form-control">
    </div>
    <div class="d-flex gap-2">
        <button class="mkv-btn-primary" type="submit">搜索</button>
        <a class="mkv-btn-secondary" asp-controller="Tags" asp-action="Index">管理标签</a>
    </div>
</form>

<form id="bulkDeleteForm" method="post" asp-action="BulkDelete">
    @Html.AntiForgeryToken()
    <input type="hidden" name="q" value="@ViewData["q"]" />
    <input type="hidden" name="tagId" value="@ViewData["tagId"]" />
    <input type="hidden" name="createdFrom" value="@ViewData["createdFrom"]" />
    <input type="hidden" name="createdTo" value="@ViewData["createdTo"]" />
    <input type="hidden" name="sort" value="@ViewData["sort"]" />
    <input type="hidden" name="dir" value="@ViewData["dir"]" />

<div class="d-flex justify-content-between mb-2" style="gap:8px;">
    <div>
        <button type="submit" class="mkv-btn-danger" onclick="return confirm('确定批量删除选中的账号？此操作不可恢复。');" disabled id="bulkDeleteBtn">删除所选</button>
        <button type="button" class="mkv-btn-quiet" id="selectAllBtn">全选</button>
        <button type="button" class="mkv-btn-quiet" id="invertSelectBtn">反选</button>
    </div>
</div>

<div class="table-responsive mkv-panel">
<table class="table mkv-data-table">
    <thead style="background:var(--mkv-bg);">
        <tr>
            <th style="width:40px;">#</th>
            <th>@{
                var sort = (ViewData["sort"] as string) ?? "updated";
                var dir = (ViewData["dir"] as string) ?? "desc";
            }
            <a href="@Url.Action("Index", new { q=ViewData["q"], tagId=ViewData["tagId"], createdFrom=ViewData["createdFrom"], createdTo=ViewData["createdTo"], sort="title", dir=sort=="title"&&dir=="asc"?"desc":"asc" })" style="color:var(--mkv-navy);text-decoration:none;">标题</a></th>
            <th>URL</th>
            <th>登录账号</th>
            <th>密码</th>
            <th><a href="@Url.Action("Index", new { q=ViewData["q"], tagId=ViewData["tagId"], createdFrom=ViewData["createdFrom"], createdTo=ViewData["createdTo"], sort="created", dir=sort=="created"&&dir=="asc"?"desc":"asc" })" style="color:var(--mkv-navy);text-decoration:none;">创建</a></th>
            <th><a href="@Url.Action("Index", new { q=ViewData["q"], tagId=ViewData["tagId"], createdFrom=ViewData["createdFrom"], createdTo=ViewData["createdTo"], sort="updated", dir=sort=="updated"&&dir=="asc"?"desc":"asc" })" style="color:var(--mkv-navy);text-decoration:none;">修改</a></th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td data-label=""><input type="checkbox" name="selectedIds" value="@item.AccountId" class="sel-chk" aria-label="选择 @item.Title" /></td>
            <td data-label="标题" style="font-weight:600;color:var(--mkv-navy);">@item.Title</td>
            <td data-label="网址" style="color:var(--mkv-text-muted);font-size:0.85rem;">@item.Url</td>
            <td data-label="登录账号">@item.AccountNameEncrypted</td>
            <td data-label="密码"><span class="mkv-password-mask" title="密码在详情页中查看">••••••••</span></td>
            <td data-label="创建" style="font-size:0.82rem;color:var(--mkv-text-muted);">@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
            <td data-label="修改" style="font-size:0.82rem;color:var(--mkv-text-muted);">@item.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
            <td data-label="操作">
                <div style="display:flex;gap:4px;">
                    <a class="mkv-btn-secondary" asp-action="Details" asp-route-id="@item.AccountId">详情</a>
                    <a class="mkv-btn-quiet" asp-action="Edit" asp-route-id="@item.AccountId">编辑</a>
                    <a class="mkv-btn-danger" asp-action="Delete" asp-route-id="@item.AccountId">删除</a>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
</form>

<script>
    (function(){
        var bulkBtn = document.getElementById('bulkDeleteBtn');
        var chks = function(){ return Array.from(document.querySelectorAll('.sel-chk')); };
        function refresh(){
            var any = chks().some(function(c){return c.checked;});
            bulkBtn.disabled = !any;
        }
        document.getElementById('selectAllBtn').addEventListener('click', function(){ chks().forEach(function(c){c.checked=true;}); refresh(); });
        document.getElementById('invertSelectBtn').addEventListener('click', function(){ chks().forEach(function(c){c.checked=!c.checked;}); refresh(); });
        chks().forEach(function(c){c.addEventListener('change', refresh);});
    })();
</script>
