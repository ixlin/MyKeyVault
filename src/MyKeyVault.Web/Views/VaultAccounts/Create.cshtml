@model MyKeyVault.Web.Models.VaultAccount
@{
    ViewData["Title"] = "新建账号";
}
<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="mkv-form-card">
      <h2 class="mb-3">新建账号</h2>
      <p class="mkv-page-description mb-4">填写基础信息、登录信息和标签，保存后可在账号库继续维护。</p>
      <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        
        <div class="mb-3">
          <label asp-for="Title" class="fw-semibold" style="color:var(--mkv-navy);font-size:0.9rem;">标题</label>
          <input asp-for="Title" class="form-control" placeholder="如：GitHub" style="border-radius:10px;border:1.5px solid var(--mkv-border);padding:0.6rem 0.8rem;" />
          <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Url" class="fw-semibold" style="color:var(--mkv-navy);font-size:0.9rem;">URL</label>
          <input asp-for="Url" class="form-control" placeholder="https://example.com" style="border-radius:10px;border:1.5px solid var(--mkv-border);padding:0.6rem 0.8rem;" />
          <span asp-validation-for="Url" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="AccountNameEncrypted" class="fw-semibold" style="color:var(--mkv-navy);font-size:0.9rem;">账号</label>
          <input asp-for="AccountNameEncrypted" class="form-control" placeholder="用户名 / 邮箱" style="border-radius:10px;border:1.5px solid var(--mkv-border);padding:0.6rem 0.8rem;" />
          <span asp-validation-for="AccountNameEncrypted" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="PasswordEncrypted" class="fw-semibold" style="color:var(--mkv-navy);font-size:0.9rem;">密码</label>
          <input asp-for="PasswordEncrypted" class="form-control" type="password" placeholder="密码" style="border-radius:10px;border:1.5px solid var(--mkv-border);padding:0.6rem 0.8rem;" />
          <span asp-validation-for="PasswordEncrypted" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="NoteEncrypted" class="fw-semibold" style="color:var(--mkv-navy);font-size:0.9rem;">备注</label>
          <textarea asp-for="NoteEncrypted" class="form-control" rows="3" placeholder="备注信息（可选）" style="border-radius:10px;border:1.5px solid var(--mkv-border);padding:0.6rem 0.8rem;"></textarea>
        </div>

        <div class="mb-3">
          <label class="fw-semibold" style="color:var(--mkv-navy);font-size:0.9rem;">标签</label>
          @if (ViewBag.AllTags != null)
          {
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;">
              @foreach (var tag in (IEnumerable<MyKeyVault.Web.Models.Tag>)ViewBag.AllTags)
              {
                <label style="display:flex;align-items:center;gap:4px;padding:0.4rem 0.8rem;background:var(--mkv-bg);border-radius:20px;cursor:pointer;font-size:0.85rem;">
                  <input type="checkbox" name="selectedTagIds" value="@tag.TagId" style="accent-color:var(--mkv-gold);" />
                  @tag.TagName
                </label>
              }
            </div>
          }
        </div>

        <div style="display:flex;gap:10px;margin-top:1.5rem;">
          <button type="submit" class="mkv-btn-primary" style="padding:0.6rem 2rem;">创建</button>
          <a asp-action="Index" class="mkv-btn-outline" style="padding:0.6rem 1.5rem;">取消</a>
        </div>
      </form>
    </div>
  </div>
</div>
