<view class="dashboard-container">
  <view wx:if="{{loading}}" class="loading-container"><view class="loading-spinner"></view><text>正在准备首页…</text></view>
  <block wx:else>
    <view wx:if="{{isGuest}}" class="guest-home">
      <view class="brand-row"><text class="brand">MyKeyVault</text><view class="guest-badge">访客模式</view></view>
      <view class="hero-card">
        <text class="hero-title">把重要账号，收进一个安全的地方</text>
        <text class="hero-copy">记录账号、密码、网址和备注；用标签快速找到它们。先了解功能，保存时再登录。</text>
        <button class="primary-button" bindtap="onAddAccountTap">体验新增账号</button>
        <text class="login-link" bindtap="onLoginTap">已有密码本？登录</text>
      </view>
      <view class="section-heading">使用方式</view>
      <view class="flow-card"><view class="step"><text class="step-no">1</text><view><text class="step-title">整理账号</text><text class="step-copy">填写名称、账号、密码和网址</text></view></view><view class="step"><text class="step-no">2</text><view><text class="step-title">添加标签</text><text class="step-copy">例如：工作、社交、购物</text></view></view><view class="step"><text class="step-no">3</text><view><text class="step-title">登录后保存</text><text class="step-copy">仅在你确认保存时创建或登录账户</text></view></view></view>
      <view class="feature-grid"><view class="feature-card"><text class="feature-icon">▣</text><text class="feature-title">账号管理</text><text class="feature-copy">按名称和网址记录</text></view><view class="feature-card"><text class="feature-icon">#</text><text class="feature-title">标签分类</text><text class="feature-copy">快速筛选和查找</text></view></view>
    </view>
    <view wx:else class="dashboard-content">
      <view class="brand-row"><text class="brand">MyKeyVault</text></view>
      <view wx:if="{{emailReminder}}" class="email-reminder">邮箱尚未验证：{{email || '绑定邮箱可增强账号安全'}}</view>
      <view class="stats-grid"><view class="stat-card" bindtap="onAccountsCardTap"><text class="stat-number">{{accountCount}}</text><text class="stat-label">账号</text></view><view class="stat-card" bindtap="onTagsCardTap"><text class="stat-number">{{tagCount}}</text><text class="stat-label">标签</text></view></view>
      <view class="section-heading">最近修改</view>
      <view wx:if="{{recentAccounts.length === 0}}" class="empty-state"><text>还没有账号记录</text><text class="empty-copy">从新增账号开始整理</text></view>
      <view wx:else class="recent-list"><view wx:for="{{recentAccounts}}" wx:key="id" class="recent-item" bindtap="onRecentAccountTap" data-id="{{item.id}}"><view><text class="recent-title">{{item.title}}</text><text class="recent-time">{{item.formattedTime}}</text></view><text class="chevron">›</text></view></view>
      <button class="primary-button" bindtap="onAddAccountTap">新增账号</button>
    </view>
  </block>
</view>
