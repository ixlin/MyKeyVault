.dashboard-container{min-height:100vh;padding:28rpx 28rpx calc(156rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f0f2f5}.loading-container{height:60vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;color:#65676b;font-size:27rpx}.loading-spinner{width:44rpx;height:44rpx;border:4rpx solid #dfe3e8;border-top-color:#1877f2;border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.brand-row{display:flex;align-items:center;justify-content:space-between;margin:10rpx 6rpx 28rpx}.brand{color:#1877f2;font-size:42rpx;font-weight:800;letter-spacing:-1rpx}.guest-badge{padding:8rpx 16rpx;border-radius:999rpx;background:#e7f3ff;color:#1877f2;font-size:22rpx}.hero-card{padding:42rpx 32rpx 34rpx;border-radius:20rpx;background:#fff;box-shadow:0 3rpx 12rpx rgba(0,0,0,.07)}.hero-title{display:block;color:#1c1e21;font-size:42rpx;font-weight:750;line-height:1.25}.hero-copy{display:block;margin-top:18rpx;color:#65676b;font-size:27rpx;line-height:1.65}.primary-button{margin-top:32rpx;border-radius:14rpx;background:#1877f2;color:#fff;font-size:29rpx;font-weight:600;line-height:88rpx}.login-link{display:block;margin-top:22rpx;color:#1877f2;font-size:27rpx;text-align:center}.section-heading{margin:38rpx 6rpx 18rpx;color:#1c1e21;font-size:32rpx;font-weight:700}.flow-card,.recent-list,.empty-state{border-radius:18rpx;background:#fff;box-shadow:0 2rpx 8rpx rgba(0,0,0,.04)}.step{display:flex;gap:22rpx;padding:26rpx 28rpx;border-bottom:1rpx solid #edf0f3}.step:last-child{border-bottom:0}.step-no{width:40rpx;height:40rpx;border-radius:50%;background:#e7f3ff;color:#1877f2;font-size:23rpx;font-weight:700;line-height:40rpx;text-align:center}.step-title,.step-copy{display:block}.step-title{color:#1c1e21;font-size:28rpx;font-weight:650}.step-copy{margin-top:7rpx;color:#65676b;font-size:24rpx}.feature-grid,.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.feature-card,.stat-card{padding:26rpx;border-radius:18rpx;background:#fff}.feature-icon{display:block;color:#1877f2;font-size:34rpx;font-weight:700}.feature-title{display:block;margin-top:14rpx;color:#1c1e21;font-size:27rpx;font-weight:650}.feature-copy{display:block;margin-top:8rpx;color:#65676b;font-size:22rpx}.stat-card{border-top:6rpx solid #1877f2}.stat-number{display:block;color:#1877f2;font-size:48rpx;font-weight:750}.stat-label{color:#65676b;font-size:25rpx}.email-reminder{margin-bottom:20rpx;padding:22rpx;border-radius:14rpx;background:#fff4d6;color:#855b00;font-size:25rpx}.empty-state{padding:54rpx 24rpx;text-align:center;color:#1c1e21;font-size:29rpx}.empty-copy{display:block;margin-top:12rpx;color:#65676b;font-size:24rpx}.recent-item{display:flex;align-items:center;justify-content:space-between;padding:26rpx;border-bottom:1rpx solid #edf0f3}.recent-item:last-child{border-bottom:0}.recent-title,.recent-time{display:block}.recent-title{font-size:28rpx;font-weight:600}.recent-time{margin-top:7rpx;color:#65676b;font-size:23rpx}.chevron{color:#8a8d91;font-size:38rpx}
