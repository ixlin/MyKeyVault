<view class="container">
  <view wx:if="{{loading}}" class="loading">正在加载个人信息…</view>

  <block wx:else>
    <view class="profile-header">
      <view class="avatar-wrap">
        <view class="avatar-mask">
          <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar">我</view>
        </view>
        <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="更换头像"></button>
      </view>
      <view class="profile-main">
        <view class="profile-title">{{nickname || '个人中心'}}</view>
        <view class="profile-subtitle">微信已绑定 · 点击头像更换</view>
      </view>
    </view>

    <view class="section settings-section">
      <view class="section-title">个人资料</view>
      <view class="setting-row" bindtap="startNicknameEdit">
        <view class="setting-label">昵称</view>
        <view class="setting-value">{{nickname || '未设置'}} <text class="chevron">›</text></view>
      </view>
      <view wx:if="{{editingNickname}}" class="inline-editor">
        <input class="text-input" type="nickname" placeholder="填写或确认微信昵称" value="{{nickname}}" bindinput="onNicknameInput" />
        <button class="inline-save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveNickname">保存</button>
      </view>
      <view class="setting-divider"></view>
      <view class="identity-row">
        <view class="setting-label">微信 ID</view>
        <view class="identity-value">{{wechatOpenId || '未绑定微信'}}</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">账号与安全</view>
      <view class="setting-row" bindtap="startEmailEdit">
        <view class="setting-label">邮箱</view>
        <view class="setting-value {{isEmailConfirmed ? 'confirmed' : 'pending'}}">
          {{isEmailConfirmed ? '已验证' : (savedEmail ? '待验证' : '绑定邮箱')}} <text class="chevron">›</text>
        </view>
      </view>
      <view wx:if="{{editingEmail}}" class="inline-editor email-editor">
        <input class="text-input" type="text" placeholder="请输入邮箱地址" value="{{email}}" bindinput="onEmailInput" />
        <view class="field-hint">{{savedEmail ? '修改后需重新验证邮箱。' : '绑定邮箱后可用于保障账号安全。'}}</view>
        <button class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveEmail">
          {{savedEmail ? '保存邮箱修改' : '绑定邮箱'}}
        </button>
      </view>
    </view>
  </block>
</view>
