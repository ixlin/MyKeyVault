.container{min-height:100vh;padding:28rpx 28rpx calc(156rpx + env(safe-area-inset-bottom));background:#f6f7f8;box-sizing:border-box}
.loading{padding-top:120rpx;text-align:center;color:#888;font-size:28rpx}
.profile-header{display:flex;align-items:center;padding:24rpx 12rpx 36rpx}
.avatar-wrap{position:relative;flex:0 0 88rpx;width:88rpx;height:88rpx;margin:0 26rpx 0 0;border-radius:9999rpx;box-shadow:0 0 0 4rpx #fff,0 8rpx 22rpx rgba(7,193,96,.18);overflow:hidden}
.avatar-mask{width:88rpx;height:88rpx;border-radius:9999rpx;overflow:hidden;background:#07c160;transform:translateZ(0)}
.avatar-picker{position:absolute;top:0;right:0;bottom:0;left:0;width:88rpx;height:88rpx;min-width:0;margin:0;padding:0;border:0;background:transparent;opacity:0}
.avatar-picker::after{border:0}
.avatar,.avatar-image{display:block;width:88rpx;height:88rpx;border-radius:9999rpx}
.avatar{background:#07c160;color:#fff;font-size:34rpx;font-weight:600;line-height:88rpx;text-align:center}
.profile-main{min-width:0;flex:1}
.profile-title{overflow:hidden;color:#222;font-size:42rpx;font-weight:600;line-height:1.25;text-overflow:ellipsis;white-space:nowrap}
.profile-subtitle{margin-top:10rpx;color:#888;font-size:25rpx}
.section{margin-bottom:24rpx;padding:28rpx;background:#fff;border-radius:16rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,.03)}
.section-title{margin-bottom:12rpx;font-size:29rpx;font-weight:600;color:#333}
.setting-row{display:flex;align-items:center;justify-content:space-between;min-height:92rpx}
.setting-label{flex:none;color:#333;font-size:29rpx}
.setting-value{overflow:hidden;margin-left:28rpx;color:#777;font-size:27rpx;text-align:right;text-overflow:ellipsis;white-space:nowrap}
.chevron{margin-left:8rpx;color:#bbb;font-size:38rpx;line-height:1;vertical-align:-2rpx}
.setting-divider{height:1rpx;background:#eee}
.identity-row{padding-top:20rpx}
.identity-value{margin-top:8rpx;color:#aaa;font-family:monospace;font-size:21rpx;line-height:1.45;word-break:break-all}
.inline-editor{padding:4rpx 0 22rpx}
.text-input{height:80rpx;padding:0 20rpx;border:1rpx solid #ddd;border-radius:10rpx;background:#fff;color:#333;font-size:28rpx;box-sizing:border-box}
.field-hint{margin-top:14rpx;color:#888;font-size:24rpx;line-height:1.5}
.confirmed{color:#07a650}.pending{color:#ad6800}
.save-button{margin-top:24rpx;background:#07c160;color:#fff;border-radius:10rpx;font-size:29rpx;line-height:88rpx}
.save-button::after{border:none}
.save-button[disabled]{background:#9bdab7;color:#fff}
.inline-save{display:block;width:150rpx;margin:16rpx 0 0 auto;border:1rpx solid #07c160;border-radius:10rpx;background:#fff;color:#07a650;font-size:28rpx;line-height:70rpx}
.inline-save::after{border:none}
.inline-save[disabled]{border-color:#9bdab7;color:#9bdab7}
