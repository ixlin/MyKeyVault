.container{min-height:100vh;padding:32rpx 28rpx 156rpx;background:#f6f7f8;box-sizing:border-box}
.loading{padding-top:120rpx;text-align:center;color:#888;font-size:28rpx}
.profile-header{display:flex;align-items:center;padding:20rpx 8rpx 32rpx}
.avatar{width:88rpx;height:88rpx;margin-right:20rpx;border-radius:50%;background:#07c160;color:#fff;font-size:34rpx;font-weight:600;line-height:88rpx;text-align:center}
.profile-title{font-size:38rpx;font-weight:600;color:#222;line-height:1.25}
.profile-subtitle{margin-top:6rpx;font-size:25rpx;color:#888}
.section{margin-bottom:24rpx;padding:28rpx;background:#fff;border-radius:16rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,.03)}
.section-title{margin-bottom:18rpx;font-size:29rpx;font-weight:600;color:#333}
.readonly-value{padding:20rpx 0;border-bottom:1rpx solid #eee;color:#333;font-family:monospace;font-size:27rpx;word-break:break-all}
.readonly-value.empty{font-family:inherit;color:#999}
.field-hint{margin-top:14rpx;color:#888;font-size:24rpx;line-height:1.5}
.email-input{height:82rpx;padding:0 20rpx;border:1rpx solid #ddd;border-radius:10rpx;background:#fff;color:#333;font-size:28rpx;box-sizing:border-box}
.email-status{margin-top:14rpx;font-size:24rpx;line-height:1.5}
.email-status.confirmed{color:#07a650}
.email-status.pending{color:#ad6800}
.save-button{margin-top:24rpx;background:#07c160;color:#fff;border-radius:10rpx;font-size:29rpx;line-height:88rpx}
.save-button::after{border:none}
.save-button[disabled]{background:#9bdab7;color:#fff}
