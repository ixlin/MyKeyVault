.container{min-height:100vh;box-sizing:border-box;padding:112rpx 48rpx;background:#f0f2f5}
.brand{color:#1877f2;font-size:54rpx;font-weight:800;letter-spacing:-2rpx;text-align:center}
.main-title{margin-top:24rpx;color:#1c1e21;font-size:38rpx;font-weight:700;text-align:center}
.intro{margin:18rpx 20rpx 56rpx;color:#65676b;font-size:27rpx;line-height:1.65;text-align:center}
.wechat-login,.binding-login{padding:40rpx 32rpx;border-radius:20rpx;background:#fff;box-shadow:0 4rpx 18rpx rgba(0,0,0,.08)}
.input{box-sizing:border-box;width:100%;height:88rpx;margin-bottom:18rpx;padding:0 24rpx;border:2rpx solid #dfe3e8;border-radius:14rpx;background:#f7f8fa;font-size:28rpx}
.btn{height:88rpx;border-radius:14rpx;background:#1877f2;color:#fff;font-size:30rpx;font-weight:600;line-height:88rpx}
.wechat-login-hint,.binding-hint{color:#65676b;font-size:27rpx;line-height:1.6;margin:0 0 28rpx;text-align:center}
.switch-link{color:#1877f2;font-size:27rpx;padding:26rpx 0 0;text-align:center}

.links-container {
  margin-top: 40rpx;
  text-align: center;
}

.hint-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.link-buttons {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
}

.link-text {
  font-size: 28rpx;
  color: #1677ff;
  text-decoration: none;
  padding: 10rpx 20rpx;
}

.separator {
  font-size: 28rpx;
  color: #ccc;
  margin: 0 20rpx;
}

.website-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}
