.tabbar{position:fixed;left:0;right:0;bottom:0;display:flex;justify-content:space-around;align-items:flex-start;height:calc(120rpx + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);background:#fff;border-top:1rpx solid #eee;box-sizing:border-box;z-index:99}
.item{flex:1;height:120rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#333}
.item .icon{font-size:40rpx;line-height:1}
.item .text{font-size:22rpx;margin-top:6rpx}
.item.active{color:#07c160}
